# Configuración del Bot de Trading Autónomo
# ============================================

# 1. Credenciales de Alpaca Markets
# Obtén tus claves gratuitas de Paper Trading en: https://alpaca.markets
ALPACA_API_KEY=tu_api_key_aqui
ALPACA_SECRET_KEY=tu_secret_key_aqui

# True para dinero virtual (Paper Trading de 100.000$), False para dinero real
ALPACA_PAPER=true

# 2. Notificaciones en Telegram
# Habla con @BotFather en Telegram para crear un bot y obtener el token
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
# Habla con @userinfobot en Telegram para obtener tu ID de chat numérico
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# 3. Parámetros de Trading y Gestión de Riesgo
# Activos a vigilar (puedes poner acciones de EE.UU. como AAPL, NVDA, TSLA o cripto como BTC/USD)
SYMBOLS=AAPL,NVDA,TSLA,MSFT

# Cantidad fija en dólares a invertir por cada operación
RISK_PER_TRADE_USD=2500.0

# Porcentaje de ganancia para cerrar automáticamente (Take Profit: 5.5% = 0.055)
TAKE_PROFIT_PCT=0.055

# Porcentaje de pérdida máxima permitida para cerrar automáticamente (Stop Loss: 2.8% = 0.028)
STOP_LOSS_PCT=0.028

# Intervalo en segundos entre cada chequeo del mercado (ej. 60 segundos)
CHECK_INTERVAL_SECONDS=60
